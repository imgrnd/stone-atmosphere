# Скопируйте на сервер, например: /etc/acrylicgoose/admin.env
# chmod 600 /etc/acrylicgoose/admin.env
#
# Логин и пароль для HTTP Basic Auth (пароль не короче 20 символов).
ADMIN_USER=stone-vibe-admin
ADMIN_PASSWORD=verysecretpassword123

# Слушать только localhost; снаружи — HTTPS reverse proxy (Caddy/nginx).
ADMIN_BIND=127.0.0.1
ADMIN_PORT=43124
